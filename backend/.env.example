APP_NAME=Brightloop Subscription Management API
APP_ENV=development
LOG_LEVEL=INFO
MONGODB_URI=mongodb://127.0.0.1:27017/brightloop
MONGODB_DATABASE=brightloop
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=5000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=3000
REQUEST_TIMEOUT_SECONDS=15
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=brightloop-api
JWT_AUDIENCE=brightloop-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@brightloop.example
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_URL=http://localhost:5173/reset-password